								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('tenant_free_id', jsonData.data.id);",
									"    pm.test('Tenant created successfully', function () {",
									"        pm.expect(jsonData.data.plan).to.eql('FREE');",
